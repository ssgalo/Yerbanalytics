# ============================================================
# Yerbanalytics — hardware simulator
# Copy this file to `.env`:  cp env.example .env
#
# Everything here belongs to the SIMULATOR. The backend does not know the simulator
# exists: the only thing on the other side is an ordinary service account (see
# BACKEND_USUARIO below), created from the dashboard like any user.
# ============================================================

# Port the simulator is served on (UI + its own server).
SIMULATOR_PORT=5180

# Nursery backend. The UI never calls it directly: it hits `/backend/**` on this same
# server, which forwards here. That is why the backend does not need to allow the
# simulator's origin through CORS.
BACKEND_URL=http://localhost:8000

# Service account the simulator signs in to the backend with (the backend demands a session
# on all of /api/**), with the Servicio role. The backend creates it on startup when it is
# listed in its YERBANALYTICS_USUARIOS_INICIALES (see Desarrollo/backend/env.example); these are
# that file's development values. It can also be created from the dashboard (Usuarios view).
# Empty = no sign-in: MQTT telemetry still works, but the backend rejects the camera panel
# and the topology, and the status bar says "sin credenciales".
BACKEND_USUARIO=simulador
BACKEND_CLAVE=simulador-yerba-2026

# MQTT broker: the same one the ESP32 firmware publishes to.
MQTT_URL=mqtt://127.0.0.1:1883

# Client-id prefix the simulator connects to the broker with.
MQTT_CLIENT_ID=yerbanalytics-simulator

# How many loads (a valve/pump run of a sector, a shade movement) a simulated node runs at once. The
# rest wait in its queue, like the ESP32 firmware does (MAX_CARGAS_SIMULTANEAS in its config.h): the
# prototype's power supply cannot take more than one. Raise it to simulate a node with a stronger supply.
SIM_NODE_MAX_LOADS=1
