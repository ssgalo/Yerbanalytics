{
  "name": "yerbanalytics-simulador",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Yerbanalytics hardware simulator: publishes telemetry to the MQTT broker as if it were an ESP32 node, and exercises the capture cycle. Standalone project: deleting this folder does not affect the system.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch --ignore \"**/*.timestamp-*.mjs\" --ignore \"data/**\" server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --prod",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.19.2",
    "mqtt": "^5.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.6"
  }
}
