# ============================================================
# Servicio de Inferencia — variables de entorno
# Copiá este archivo a .env y completá los valores.
# El servicio carga <carpeta del servicio>/.env sin pisar las variables que ya estén definidas en
# el entorno (en Docker mandan las de docker-compose.yml).
# Las rutas relativas (MODEL_PATH, CAPTURAS_DIR) se resuelven contra la carpeta del servicio, no
# contra el directorio desde el que se lo lance.
# ============================================================

# URL base del backend (sin barra final)
BACKEND_URL=http://localhost:8000

# Cuenta de servicio con la que el servicio inicia sesión en el backend (que exige sesión en
# toda /api/**), con rol Servicio. El backend la crea al arrancar si figura en su
# YERBANALYTICS_USUARIOS_INICIALES (ver Desarrollo/backend/env.example); estos valores son los de
# desarrollo de ese archivo. Vacías = el backend rechaza las llamadas.
BACKEND_USUARIO=inferencia
BACKEND_CLAVE=inferencia-yerba-2026

# Checkpoint del detector (YOLOv8, imgsz=1024). OBLIGATORIA. No se versiona (*.pt en .gitignore):
# ver "Modelo" en el README.
MODEL_PATH=modelo_final.pt

# Directorio raíz de las imágenes, el mismo donde las guarda el backend. El servicio arma la ruta
# completa concatenando este valor con el fileName que devuelve el endpoint de pendientes.
# Local: ../backend/capturas (el backend corriendo desde Desarrollo/backend). Docker: /capturas.
CAPTURAS_DIR=../backend/capturas

# Intervalo entre ciclos de polling (en segundos). Default: 14400 (4 horas).
POLLING_INTERVAL_SECONDS=14400

# ============================================================
# Mapeo de clases del modelo
# ============================================================
# Estados de la plataforma en el MISMO ORDEN que model.names del checkpoint (la posición N es la
# clase N del modelo). Para modelo_final.pt:
#   0 clorosis · 1 colapso_hongos · 2 estres_solar · 3 plaga_foliar · 4 sano
# El servicio no arranca si la cantidad no coincide con la del checkpoint, y al arrancar deja en el
# log el mapeo índice → nombre del checkpoint → estado: revisalo si cambiás de modelo.
#
# Valores válidos (taxonomía del backend):
#   Sano, Clorosis, Estrés solar, Daño biótico, Ácaro, Plaga foliar, Daño fúngico
MODEL_CLASSES=Clorosis,Daño fúngico,Estrés solar,Plaga foliar,Sano

# ============================================================
# Parámetros del EQUIPO (calibración del modelo)
# ============================================================
# Valores PROVISORIOS: se reemplazan cuando el equipo los defina con las curvas PR. No se editan
# desde el dashboard (el criterio del agrónomo, sí: Configuración → Criterio de diagnóstico).
# Ausente = default con un WARNING en el log. Mal formado = el servicio no arranca.

# Umbral global de la inferencia. Debe ser ≤ al menor umbral de validez de las clases.
YOLO_CONF_GLOBAL=0.10

# IoU desde el que dos cajas válidas se consideran la misma hoja (resolución de solapes).
SOLAPAMIENTO_IOU=0.60

# Bandas de confianza por clase, sobre el score crudo: "válida desde, media desde, alta desde".
# Tres números en (0, 1], estrictamente crecientes. La clave sale del estado sin acentos ni espacios.
BANDAS_CONFIANZA_SANO=0.60,0.70,0.80
BANDAS_CONFIANZA_CLOROSIS=0.40,0.55,0.70
BANDAS_CONFIANZA_ESTRES_SOLAR=0.40,0.55,0.70
BANDAS_CONFIANZA_PLAGA_FOLIAR=0.35,0.50,0.65
BANDAS_CONFIANZA_DANO_FUNGICO=0.35,0.50,0.65
