# ============================================================
# Servicio de Inferencia — variables de entorno
# Copiá este archivo a .env y completá los valores.
# ============================================================

# URL base del backend (sin barra final)
BACKEND_URL=http://localhost:8080

# Ruta absoluta al archivo .pt del modelo entrenado (OBLIGATORIA)
# Ejemplo: /modelos/mobilenetv3_yerbanalytics.pt
MODEL_PATH=

# Directorio raíz del volumen de imágenes compartido con el backend.
# El servicio construye la ruta completa concatenando este valor con el fileName
# devuelto por el endpoint de pendientes.
CAPTURAS_DIR=/capturas

# Intervalo entre ciclos de polling (en segundos). Default: 14400 (4 horas).
POLLING_INTERVAL_SECONDS=14400

# ============================================================
# Mapeo de clases del modelo
# ============================================================
# Lista de clases en el MISMO ORDEN que las salidas del modelo entrenado,
# separadas por comas. El índice de la clase dominante en la salida del
# modelo se usa para buscar el estado correspondiente en esta lista.
#
# Los valores DEBEN pertenecer a la taxonomía del backend:
#   Sano, Clorosis, Estrés solar, Daño biótico, No concluyente,
#   Ácaro, Plaga foliar, Daño fúngico
#
# Ejemplo (ajustar al orden real del entrenamiento):
MODEL_CLASSES=Sano,Clorosis,Estrés solar,Daño biótico,No concluyente,Ácaro,Plaga foliar,Daño fúngico
