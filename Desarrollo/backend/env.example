# ============================================================
# Yerbanalytics — backend
# Copiá este archivo a `.env` (cp env.example .env); el backend lo lee al arrancar
# (spring.config.import en application.properties). `.env` no se versiona.
# Una variable de entorno del sistema con el mismo nombre le gana a este archivo.
#
# Los valores de abajo son de DESARROLLO y coinciden con los env.example del simulador y del
# servicio de inferencia, para que un clon nuevo funcione sin tocar nada. En un vivero real,
# cambialos todos.
# ============================================================

# Administrador inicial: se crea SÓLO si la base no tiene ningún Administrador activo, y se le
# pide cambiar la contraseña en el primer ingreso. Es obligatoria para crearlo: vacía, el backend
# no arranca (la clave no se genera).
YERBANALYTICS_ADMIN_USUARIO=admin
YERBANALYTICS_ADMIN_CLAVE=admin-yerba-2026

# Cuentas que se crean al arrancar si su usuario no existe. Nunca se modifican después: una vez
# creadas se administran desde la vista Usuarios del dashboard.
# Formato: usuario:ROL:clave, separadas por coma (la clave no puede tener comas; mínimo 8
# caracteres y distinta del usuario).
# Roles: ADMINISTRADOR, INGENIERO_AGRONOMO, PRODUCTOR_VIVERISTA, OPERARIO, SERVICIO.
# Las de rol SERVICIO nacen con la clave definitiva (las usan integraciones, no personas); las
# demás, con clave temporal.
YERBANALYTICS_USUARIOS_INICIALES=simulador:SERVICIO:simulador-yerba-2026,inferencia:SERVICIO:inferencia-yerba-2026
