# ============================================================
# Modo estático (demo ilustrativa) — `npm run dev:demo` / `npm run build:demo`.
#
# Este archivo SÍ se versiona: define un modo de la aplicación, no configuración de una
# máquina. Toda la app se sirve del mock determinístico y no se consulta el backend, así que
# la demo levanta sin backend, sin base de datos y sin broker.
#
# El modo normal (`npm run dev`) usa `.env`, con VITE_DATA_SOURCE=http: el sistema real.
# ============================================================

VITE_DATA_SOURCE=mock
VITE_MOCK_SEED=20260613
