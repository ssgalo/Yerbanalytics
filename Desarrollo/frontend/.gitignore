# dependencias
node_modules
.pnp
.pnp.js

# build
dist
dist-ssr
*.local

# entorno
.env
.env.*
!env.example
# `.env.demo` SÍ se versiona: no es configuración local sino la definición del modo
# estático (`npm run dev:demo`). No lleva secretos —las VITE_* llegan al navegador— y sin
# él un clon nuevo no podría levantar la demo.
!.env.demo

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Salida de `tsc -b` del proyecto referenciado. NUNCA debe quedar al lado del fuente:
# Vite resuelve `vite.config.js` ANTES que `vite.config.ts`, así que un compilado suelto
# secuestra la configuración y toda edición del `.ts` se ignora en silencio.
vite.config.js
vite.config.d.ts
*.tsbuildinfo
