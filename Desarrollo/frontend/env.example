# ============================================================
# Yerbanalytics frontend — variables de entorno
# Copiá este archivo a `.env`:  cp env.example .env
# Solo las variables con prefijo VITE_ llegan al navegador.
# ============================================================

# Origen de datos. Es el ÚNICO interruptor del modo de operación de la app, y rige para
# TODAS las secciones (vivero, mapa, sector, diagnósticos, hardware, configuración,
# historial y topología): nunca conviven datos mock con datos del backend en pantalla.
#
#   http  → sistema real. Es lo que corre en producción. Para inyectarle hardware simulado
#           se levanta aparte el simulador (`Desarrollo/simulador/`), que publica al broker
#           como si fuera un nodo ESP32. El dashboard no se entera de que existe.
#
#   mock  → demo ilustrativa, determinística y sin backend. No es funcional: sirve para
#           mostrar cómo se vería el sistema. Ya está preconfigurado en `.env.demo`,
#           así que alcanza con `npm run dev:demo`.
#
# El modo se resuelve al arrancar, así que cambiarlo requiere reiniciar el dashboard.
VITE_DATA_SOURCE=http

# URL base del backend (se usa cuando VITE_DATA_SOURCE=http)
VITE_API_BASE_URL=http://localhost:8000/api

# Semilla del generador determinístico (modo mock).
# Cambiarla regenera todo el vivero de forma reproducible.
VITE_MOCK_SEED=20260613
