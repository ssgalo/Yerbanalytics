# ─────────────────────────────────────────────────────────────
# Datasets — NO se versionan. Viven en Google Drive y se
# re-descargan desde sus fuentes (ver datasets/README.md).
# Se conserva sólo el README que documenta cada dataset.
# ─────────────────────────────────────────────────────────────
Desarrollo/Modelo_IA/datasets/*
!Desarrollo/Modelo_IA/datasets/README.md

# Archivos comprimidos (descargas crudas de datasets)
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# ─────────────────────────────────────────────────────────────
# Python / Jupyter / Colab
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/
env/

# Modelos entrenados / checkpoints (pesados, no van a git)
*.h5
*.pt
*.pth
*.ckpt
*.onnx
*.tflite

# Screenshots sueltos en la raíz del repo (no son assets del proyecto)
/*.png

# ─────────────────────────────────────────────────────────────
